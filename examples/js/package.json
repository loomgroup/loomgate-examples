{
  "name": "loomgate-example-js",
  "private": true,
  "description": "Loomgate checkout with the JavaScript SDK from npm (Vite, no framework) and a Cloudflare Worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loompay/loomgate-js-sdk": "^0.1.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
