{
  "name": "loomgate-example-js",
  "private": true,
  "description": "Loomgate checkout with the JavaScript SDK from npm (Vite, no framework) and a Cloudflare Worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loompay/loomgate-js-sdk": "^0.1.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261008.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
